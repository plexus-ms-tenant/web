# Every variable this app reads, one per line (§ 5.3 PLX). Values come from
# the platform — the tenant inventory's apps[].env and apps[].secrets — never
# from this repo.

# Bearer token the compendium webhook and the container's own boot-time
# refresh present to POST /compendium/revalidate.
REVALIDATE_TOKEN= # required secret
# Git ref of plexus-ms/compendium to render.
COMPENDIUM_REF=main
# GitHub token for a higher API rate limit when fetching the compendium; anonymous without it.
GITHUB_TOKEN= # secret
# Port the Next.js server listens on inside the container.
PORT=3000
