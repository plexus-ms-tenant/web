{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["mise.toml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["CI", "DATABASE_URL", "E2E_*", "PLAYWRIGHT_*", "PW_TEST_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
