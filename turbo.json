{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/{README,AGENTS,PLEXUS}.md",
        "!.copier-answers.yml",
        "!docs/**",
        "!docker/compose*.yaml"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/{README,AGENTS,PLEXUS}.md",
        "!.copier-answers.yml",
        "!docs/**",
        "!docker/compose*.yaml"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/{README,AGENTS,PLEXUS}.md", "!.copier-answers.yml", "!docs/**"],
      "passThroughEnv": ["CI", "DATABASE_URL", "E2E_*", "PLAYWRIGHT_*", "PW_TEST_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
